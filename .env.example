# .env.example (en la raíz: Sisgad5_1.0/.env.example)

# ===== Entorno General =====
NODE_ENV=development

# ===== PostgreSQL (compartido) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ===== API Gateway =====
GATEWAY_PORT=5000
CORS_ORIGIN=http://localhost:5173
USERS_SERVICE_URL=http://localhost:5001
MP_SERVICE_URL=http://localhost:5002
MATERIALES_SERVICE_URL=http://localhost:5003
FRONTEND_URL=http://localhost:5173

# ===== Backend Users =====
USERS_PORT=5001
USERS_DB_NAME=bd_sisgad5_users

# ===== Backend MP (este microservicio) =====
MP_PORT=5002
MP_DB_NAME=bd_sisgad5_mp

# ===== JWT (compartido) =====
JWT_SECRET=your_very_long_random_jwt_secret_here_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Frontend =====
VITE_API_URL=http://localhost:5000/api
VITE_FRONT_URL=http://localhost:5173

# ===== Backend Materiales =====
MATERIALES_PORT=5003
MATERIALES_DB_NAME=bd_sisgad5_materiales

# ===== Prediction Service (Python) =====
PREDICTION_PORT=5005
PREDICTION_DB_NAME=bd_sisgad5_predictions

# ===== Logging & Seguridad =====
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== Grafana =====
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password_at_least_16_chars